# 数据库 (MySQL 8.0+)
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/kirameku?charset=utf8mb4

# 应用密钥
SECRET_KEY=your-secret-key

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://your-domain.com

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MinIO 对象存储
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kirameku
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://127.0.0.1:9000/kirameku
